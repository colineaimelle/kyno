 <!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kyno — Nutrition Canine Individualisée</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --sage:       #5C7A5E;
    --sage-light: #7D9B7F;
    --sage-mist:  #EDF3ED;
    --ecru:       #F5F0E8;
    --sand:       #E8E0D0;
    --honey:      #C4A15A;
    --tabac:      #7B5C3E;
    --warm-white: #FAF8F4;
    --dark:       #2A1F14;
  }

  * { margin:0; padding:0; box-sizing:border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--warm-white);
    color: var(--tabac);
    font-weight: 300;
    overflow-x: hidden;
  }

  /* ── LANG SWITCHER ── */
  .lang-bar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 200;
    background: var(--warm-white);
    border-bottom: 1px solid var(--sand);
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 48px;
  }
  .lang-logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 400;
    color: var(--sage);
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .lang-nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .lang-nav a {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--honey);
    text-decoration: none;
    transition: color 0.2s;
  }
  .lang-nav a:hover { color: var(--sage); }
  .lang-switch {
    display: flex;
    gap: 4px;
    margin-left: 16px;
  }
  .lang-btn {
    font-size: 11px;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 3px;
    border: 1px solid var(--sand);
    background: transparent;
    color: var(--honey);
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    transition: all 0.2s;
  }
  .lang-btn.active {
    background: var(--sage);
    color: white;
    border-color: var(--sage);
  }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    padding-top: 48px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    position: relative;
    overflow: hidden;
  }

  .hero-left {
    padding: 100px 64px 80px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 40px;
    position: relative;
    z-index: 2;
  }

  .hero-eyebrow {
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--sage-light);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .hero-eyebrow::before {
    content: '';
    width: 32px;
    height: 1px;
    background: var(--sage-light);
  }

  .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 76px;
    line-height: 1.0;
    font-weight: 400;
    color: var(--tabac);
    letter-spacing: -0.02em;
  }
  .hero-title em {
    font-style: italic;
    color: var(--sage);
  }

  .hero-desc {
    font-size: 16px;
    line-height: 1.8;
    color: var(--honey);
    max-width: 420px;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .btn-primary {
    background: var(--sage);
    color: white;
    padding: 16px 32px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    border: none;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    text-decoration: none;
    display: inline-block;
    transition: background 0.2s, transform 0.15s;
  }
  .btn-primary:hover {
    background: var(--sage-light);
    transform: translateY(-1px);
  }

  .btn-ghost {
    color: var(--tabac);
    font-size: 13px;
    font-weight: 400;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
    letter-spacing: 0.04em;
  }

  .hero-stats {
    display: flex;
    gap: 40px;
    padding-top: 16px;
    border-top: 1px solid var(--sand);
  }
  .stat-item {}
  .stat-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    font-weight: 400;
    color: var(--tabac);
  }
  .stat-label {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--honey);
  }

  .hero-right {
    position: relative;
    background: var(--ecru);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-right::before {
    content: '';
    position: absolute;
    top: -100px; right: -100px;
    width: 400px; height: 400px;
    border-radius: 50%;
    background: var(--sage-mist);
    opacity: 0.6;
  }

  .hero-card {
    position: relative;
    z-index: 2;
    background: white;
    border-radius: 16px;
    padding: 36px;
    width: 340px;
    box-shadow: 0 24px 64px rgba(92,74,62,0.1);
    border: 1px solid var(--sand);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
  }
  .card-avatar {
    width: 44px; height: 44px;
    background: var(--sage-mist);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }
  .card-dog-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    color: var(--tabac);
  }
  .card-dog-info {
    font-size: 12px;
    color: var(--honey);
  }
  .card-tag {
    margin-left: auto;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--sage-mist);
    color: var(--sage);
    padding: 4px 10px;
    border-radius: 3px;
  }

  .card-score {
    background: var(--tabac);
    border-radius: 10px;
    padding: 20px 24px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .score-label { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.5); margin-bottom: 4px; }
  .score-val {
    font-family: 'Cormorant Garamond', serif;
    font-size: 48px;
    color: var(--ecru);
    line-height: 1;
  }
  .score-unit { font-size: 16px; color: var(--honey); }
  .score-season { font-size: 12px; color: var(--sage-light); margin-top: 4px; }

  .card-bars { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }
  .bar-row { }
  .bar-info { display: flex; justify-content: space-between; font-size: 11px; color: var(--honey); margin-bottom: 5px; }
  .bar-track { height: 3px; background: var(--sand); border-radius: 2px; overflow: hidden; }
  .bar-fill { height: 100%; background: var(--sage-light); border-radius: 2px; }

  .card-menu { display: flex; flex-direction: column; gap: 8px; }
  .menu-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 10px 14px;
    background: var(--ecru);
    border-radius: 8px;
    font-size: 12px;
  }
  .menu-name { color: var(--tabac); font-weight: 400; }
  .menu-qty { color: var(--honey); }

  /* ── SECTION POURQUOI ── */
  .section-why {
    padding: 120px 64px;
    background: var(--warm-white);
  }

  .section-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: end;
    margin-bottom: 80px;
  }

  .section-label {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sage-light);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .section-label::before {
    content: '';
    width: 24px; height: 1px;
    background: var(--sage-light);
  }

  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 52px;
    line-height: 1.1;
    font-weight: 400;
    color: var(--tabac);
    letter-spacing: -0.01em;
  }
  .section-title em { color: var(--sage); font-style: italic; }

  .section-desc {
    font-size: 15px;
    line-height: 1.9;
    color: var(--honey);
    align-self: end;
  }

  .why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 2px;
    background: var(--sand);
    border-radius: 12px;
    overflow: hidden;
  }

  .why-card {
    background: var(--warm-white);
    padding: 48px 40px;
    transition: background 0.3s;
  }
  .why-card:hover { background: var(--ecru); }

  .why-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 56px;
    color: var(--sand);
    font-weight: 300;
    line-height: 1;
    margin-bottom: 24px;
  }

  .why-icon {
    width: 40px; height: 40px;
    background: var(--sage-mist);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .why-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    font-weight: 400;
    color: var(--tabac);
    margin-bottom: 12px;
    line-height: 1.2;
  }

  .why-desc {
    font-size: 14px;
    line-height: 1.8;
    color: var(--honey);
  }

  /* ── COMMENT ÇA MARCHE ── */
  .section-how {
    padding: 120px 64px;
    background: var(--ecru);
  }

  .how-steps {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 48px;
    margin-top: 80px;
    position: relative;
  }

  .how-steps::before {
    content: '';
    position: absolute;
    top: 28px;
    left: 15%;
    right: 15%;
    height: 1px;
    background: var(--sand);
    z-index: 0;
  }

  .how-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    position: relative;
    z-index: 1;
  }

  .step-circle {
    width: 56px; height: 56px;
    border-radius: 50%;
    background: var(--warm-white);
    border: 1.5px solid var(--sage-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    color: var(--sage);
  }

  .step-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 400;
    color: var(--tabac);
  }

  .step-desc {
    font-size: 14px;
    line-height: 1.8;
    color: var(--honey);
  }

  /* ── OFFRES ── */
  .section-offers {
    padding: 120px 64px;
    background: var(--warm-white);
  }

  .offers-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 80px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .offer-card {
    border-radius: 16px;
    padding: 48px 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .offer-card.basic {
    background: var(--ecru);
    border: 1px solid var(--sand);
  }

  .offer-card.premium {
    background: var(--tabac);
  }

  .offer-tag {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 3px;
    width: fit-content;
  }
  .basic .offer-tag { background: var(--sage-mist); color: var(--sage); }
  .premium .offer-tag { background: rgba(255,255,255,0.12); color: var(--ecru); }

  .offer-price {
    display: flex;
    align-items: flex-end;
    gap: 6px;
  }
  .price-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 64px;
    line-height: 1;
    font-weight: 300;
  }
  .basic .price-num { color: var(--tabac); }
  .premium .price-num { color: var(--ecru); }

  .price-detail {
    display: flex;
    flex-direction: column;
    padding-bottom: 10px;
  }
  .price-currency { font-size: 20px; color: var(--honey); }
  .price-freq { font-size: 12px; color: var(--honey); }
  .premium .price-freq { color: rgba(255,255,255,0.5); }

  .offer-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 26px;
    font-weight: 400;
  }
  .basic .offer-name { color: var(--tabac); }
  .premium .offer-name { color: var(--ecru); }

  .offer-desc {
    font-size: 14px;
    line-height: 1.8;
  }
  .basic .offer-desc { color: var(--honey); }
  .premium .offer-desc { color: rgba(255,255,255,0.65); }

  .offer-features {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    line-height: 1.5;
  }
  .basic .feature-item { color: var(--tabac); }
  .premium .feature-item { color: rgba(255,255,255,0.8); }

  .feature-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    margin-top: 7px;
    flex-shrink: 0;
  }
  .basic .feature-dot { background: var(--sage-light); }
  .premium .feature-dot { background: var(--honey); }

  .offer-btn {
    padding: 15px 28px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    border: none;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    text-align: center;
    transition: all 0.2s;
    text-decoration: none;
    display: block;
  }
  .basic .offer-btn {
    background: var(--sage);
    color: white;
  }
  .basic .offer-btn:hover { background: var(--sage-light); }
  .premium .offer-btn {
    background: var(--honey);
    color: white;
  }
  .premium .offer-btn:hover { opacity: 0.9; }

  /* ── TESTIMONIALS ── */
  .section-testi {
    padding: 120px 64px;
    background: var(--ecru);
  }

  .testi-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 24px;
    margin-top: 80px;
  }

  .testi-card {
    background: var(--warm-white);
    border-radius: 12px;
    padding: 36px;
    border: 1px solid var(--sand);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .testi-quote {
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    font-style: italic;
    color: var(--tabac);
    line-height: 1.7;
  }

  .testi-author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
  }

  .testi-avatar {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--sage-mist);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
  }

  .testi-name { font-size: 13px; font-weight: 500; color: var(--tabac); }
  .testi-dog { font-size: 11px; color: var(--honey); }

  /* ── CTA FINAL ── */
  .section-cta {
    padding: 120px 64px;
    background: var(--tabac);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .cta-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 64px;
    font-weight: 400;
    color: var(--ecru);
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 700px;
  }
  .cta-title em { color: var(--sage-light); font-style: italic; }

  .cta-desc {
    font-size: 15px;
    color: rgba(245,240,232,0.6);
    max-width: 480px;
    line-height: 1.8;
  }

  .btn-cta {
    background: var(--sage-light);
    color: white;
    padding: 18px 48px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.08em;
    border: none;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    text-decoration: none;
    display: inline-block;
    transition: all 0.2s;
  }
  .btn-cta:hover { background: var(--sage); transform: translateY(-2px); }

  /* ── FOOTER ── */
  footer {
    background: var(--dark);
    padding: 64px;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
  }

  .footer-brand {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px;
    color: var(--ecru);
    margin-bottom: 16px;
  }

  .footer-tagline {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(245,240,232,0.35);
    margin-bottom: 24px;
  }

  .footer-copy {
    font-size: 12px;
    color: rgba(245,240,232,0.3);
    line-height: 1.7;
  }

  .footer-col h4 {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--honey);
    margin-bottom: 20px;
  }

  .footer-col a {
    display: block;
    font-size: 13px;
    color: rgba(245,240,232,0.5);
    text-decoration: none;
    margin-bottom: 10px;
    transition: color 0.2s;
  }
  .footer-col a:hover { color: var(--ecru); }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero-eyebrow { animation: fadeUp 0.6s ease both; animation-delay: 0.1s; }
  .hero-title   { animation: fadeUp 0.7s ease both; animation-delay: 0.2s; }
  .hero-desc    { animation: fadeUp 0.7s ease both; animation-delay: 0.35s; }
  .hero-cta-group { animation: fadeUp 0.7s ease both; animation-delay: 0.5s; }
  .hero-stats   { animation: fadeUp 0.7s ease both; animation-delay: 0.65s; }
  .hero-card    { animation: fadeUp 0.8s ease both; animation-delay: 0.4s; }

  /* ── MOBILE ── */
  @media (max-width: 768px) {
    .lang-bar { padding: 0 20px; }
    .lang-nav { display: none; }

    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .hero-left { padding: 80px 24px 48px; }
    .hero-title { font-size: 48px; }
    .hero-right { min-height: 400px; padding: 48px 24px; }
    .hero-card { width: 100%; }

    .section-why, .section-how, .section-offers, .section-testi, .section-cta { padding: 80px 24px; }

    .section-intro { grid-template-columns: 1fr; gap: 24px; }
    .section-title { font-size: 36px; }

    .why-grid, .how-steps, .testi-grid { grid-template-columns: 1fr; }
    .how-steps::before { display: none; }

    .offers-grid { grid-template-columns: 1fr; }

    .cta-title { font-size: 40px; }

    footer { grid-template-columns: 1fr 1fr; gap: 32px; padding: 48px 24px; }
  }
</style>
</head>
<body>

<!-- NAV -->
<nav class="lang-bar">
  <a href="#" class="lang-logo">
    <svg width="20" height="20" viewBox="0 0 52 52" fill="none">
      <circle cx="26" cy="26" r="25" stroke="#5C7A5E" stroke-width="1.2"/>
      <path d="M19 15 C19.5 20 19.5 32 19 37" stroke="#5C7A5E" stroke-width="1.8" stroke-linecap="round"/>
      <path d="M19 26 C22 24 26 21 31 15.5" stroke="#5C7A5E" stroke-width="1.8" stroke-linecap="round"/>
      <path d="M22 27.5 C25 30 28 33 32 37.5" stroke="#5C7A5E" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
    kyno
  </a>
  <div style="display:flex;align-items:center;gap:32px;">
    <div class="lang-nav">
      <a href="#pourquoi">Le concept</a>
      <a href="#comment">Comment ça marche</a>
      <a href="#offres">Tarifs</a>
      <a href="#" style="color:var(--sage);">Commencer →</a>
    </div>
    <div class="lang-switch">
      <button class="lang-btn active" onclick="setLang('fr')">FR</button>
      <button class="lang-btn" onclick="setLang('en')">EN</button>
    </div>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-left">
    <div class="hero-eyebrow" data-fr="Nutrition canine individualisée" data-en="Individualised canine nutrition">Nutrition canine individualisée</div>

    <h1 class="hero-title">
